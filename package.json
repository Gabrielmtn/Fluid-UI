{
  "name": "fluid-ui-multiplayer",
  "version": "1.0.0",
  "description": "Fluid simulation with multiplayer support via PartyKit",
  "main": "electron-main.js",
  "scripts": {
    "dev": "partykit dev --serve .",
    "deploy": "partykit deploy",
    "party": "partykit dev",
    "serve": "npx http-server -p 8080 -c-1",
    "electron": "electron .",
    "electron-build": "electron-builder"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "partykit": "^0.0.111"
  },
  "devDependencies": {
    "electron": "^39.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.fluidsim.app",
    "productName": "Fluid Simulation",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!zig/**",
      "!node_modules/**",
      "!dist/**",
      "!.git/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
