# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PartyKit
.partykit/

# Generated web bundle (built by scripts/build-web.js, served by partykit deploy)
public/

# Desktop build output (electron-builder: unpacked app, portable exe, Steam logs)
dist/

# Backup files
*.backup

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local config (contains machine-specific paths)
.claude/

# Session/debug scratch files (CDP drivers, preset dumps)
tmp-*

# Environment variables
.env
.env.local
.env.*.local

# Steamworks dev-only app id (never ship: silently changes launch behavior)
steam_appid.txt

# Baked Steam imagery (regenerate with scripts/bake-*.js — ~90MB of PNGs).
# The bake SCRIPTS and the copy docs stay tracked; only their output is
# ignored. steam/store-assets/ and steam/library-assets/ are the final
# deliverables and DO stay in git.
steam/screenshots/
steam/store-assets-slicebg/
steam/about/images/
